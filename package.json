{
  "name": "student-dashboard",
  "version": "26.06.02",
  "type": "module",
  "description": "Student Dashboard PowerSchool plugin",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "vite build && node node_modules/@tesd-tech/ps-package/index.js",
    "test": "pnpm test:run && pnpm test:e2e",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test:run && pnpm test:e2e",
    "redact": "node scripts/redact-names.cjs public/data.json > public/data-redacted.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@tesd-tech/ps-package": "^25.10.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}